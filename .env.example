BITRIX_BASE_URL=https://your-portal.bitrix24.ru
BITRIX_KEY_202=replace-with-webhook-key # todo Переименовать на KEY_N в зависимости от портала (тестовый или нет), и в config тоже key_202
BITRIX_USER_ID=1
# Safety: writes are disabled unless BOTH are set explicitly.
BITRIX_WRITE_ENABLED=false
BITRIX_DRY_RUN=true
BITRIX_RPS=1.8

PORTAL_BASE_URL=https://fedresurs.ru
PORTAL_LAUNCH_MODE=local
PORTAL_PROFILE_DIR=var/browser-profile
PORTAL_MIN_INTERVAL_MS=1500
PORTAL_JITTER_MS=800
PORTAL_MAX_RETRIES=5
PORTAL_SESSION_TTL_MIN=15

DB_PATH=var/fedresurs.sqlite3
LOG_LEVEL=INFO
LOG_DIR=var/log
FILTER_CONFIG_PATH=config/filters.toml
FIELD_MAP_PATH=config/bitrix_fieldmap.toml
